# LLM Providers (set the one you use)
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
DASHSCOPE_CN_API_KEY=
ZHIPU_API_KEY=
ZHIPU_CN_API_KEY=
MINIMAX_API_KEY=
MINIMAX_CN_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
MOONSHOT_API_KEY=
GROQ_API_KEY=
NVIDIA_API_KEY=

# Azure OpenAI Responses API (use the resource root, not /openai/responses).
#AZURE_OPENAI_API_KEY=
#AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
#AZURE_OPENAI_DEPLOYMENT_NAME=gpt-6.1-sol
#AZURE_OPENAI_API_VERSION=2025-04-01-preview

# X API v2 recent-Post search for the Sentiment Analyst. Optional and usage-billed by X.
#X_BEARER_TOKEN=
#X_POST_LIMIT_PER_SYMBOL=20
#X_CACHE_TTL_SECONDS=86400

# StockTwits Firestream aggregate sentiment (optional; requires an authorized account).
#STOCKTWITS_USERNAME=
#STOCKTWITS_PASSWORD=

# SEC EDGAR (US company filings, point-in-time). No key; a contact address SEC can reach you at.
#SEC_EDGAR_USER_AGENT=Your Name your@email.com

# FRED (Federal Reserve macro data). Free key: https://fred.stlouisfed.org/docs/api/api_key.html
#FRED_API_KEY=

# Alpaca Market Data news (optional). The ALPACA_API_* aliases are also accepted.
#APCA_API_KEY_ID=
#APCA_API_SECRET_KEY=
#ALPACA_API_KEY=
#ALPACA_SECRET_KEY=

# Finnhub shared enrichment for news, fundamentals, insiders, events and live context.
# Get the key from https://finnhub.io/dashboard and set the per-minute value shown there.
#FINNHUB_API_KEY=
#FINNHUB_REQUESTS_PER_MINUTE=30
#FINNHUB_MAX_CALLS_PER_RUN=30
#FINNHUB_MAX_CONCURRENCY=2
#FINNHUB_CACHE_TTL_SECONDS=900
#FINNHUB_HISTORICAL_CACHE_TTL_SECONDS=86400

# TypeSafe Jev: screens X and Reddit posts for the Sentiment Analyst. Optional.
#TYPESAFE_API_KEY=
#TYPESAFE_DEFAULT_MODEL=jev-latest

# Custom OpenAI-compatible endpoint (vLLM, LM Studio, llama.cpp). Local servers need no key.
#OPENAI_COMPATIBLE_API_KEY=

# AWS Bedrock (pip install ".[bedrock]"). Bearer token, or the AWS credential chain; set the region either way.
#AWS_BEARER_TOKEN_BEDROCK=
#AWS_DEFAULT_REGION=us-west-2
#AWS_PROFILE=

# Remote Ollama server. Unset uses http://localhost:11434/v1.
#OLLAMA_BASE_URL=http://your-ollama-host:11434/v1

# Override these DEFAULT_CONFIG keys. Provider, models, language and round counts also skip their CLI prompt.
#TRADINGAGENTS_LLM_PROVIDER=openai  # or azure_responses
#TRADINGAGENTS_DEEP_THINK_LLM=gpt-6-sol
#TRADINGAGENTS_QUICK_THINK_LLM=gpt-6-luna
#TRADINGAGENTS_LLM_BACKEND_URL=
#TRADINGAGENTS_OUTPUT_LANGUAGE=English
#TRADINGAGENTS_MAX_DEBATE_ROUNDS=1
#TRADINGAGENTS_MAX_RISK_ROUNDS=1
#TRADINGAGENTS_CHECKPOINT_ENABLED=false

# Paths and alpha benchmark. Unset uses ~/.tradingagents and the regional index.
#TRADINGAGENTS_RESULTS_DIR=
#TRADINGAGENTS_CACHE_DIR=
#TRADINGAGENTS_MEMORY_LOG_PATH=
#TRADINGAGENTS_BENCHMARK_TICKER=SPY

# Lower temperature means less run-to-run variation on models that honor it.
#TRADINGAGENTS_TEMPERATURE=0.0

# Retry budget for every LLM SDK. Raise it to ride out 429 throttling.
#TRADINGAGENTS_LLM_MAX_RETRIES=6

# Cap output tokens to bound a model that runs long and trips a timeout.
#TRADINGAGENTS_MAX_TOKENS=8192

# Local HTTP API. Keep the default loopback host unless the service is protected
# by a trusted network/reverse proxy. Set a strong key before non-local access.
#TRADINGAGENTS_API_HOST=127.0.0.1
#TRADINGAGENTS_API_PORT=8000
#TRADINGAGENTS_API_KEY=
#TRADINGAGENTS_API_DB_PATH=~/.tradingagents/api_jobs.sqlite3
#TRADINGAGENTS_API_WORKERS=1
#TRADINGAGENTS_API_MAX_JOBS=500

# Reasoning depth per provider; setting one skips its prompt.
#TRADINGAGENTS_OPENAI_REASONING_EFFORT=medium
#TRADINGAGENTS_GOOGLE_THINKING_LEVEL=high
#TRADINGAGENTS_ANTHROPIC_EFFORT=high
