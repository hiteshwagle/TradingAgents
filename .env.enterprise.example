# Azure OpenAI
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT_NAME=
AZURE_OPENAI_API_VERSION=2025-04-01-preview

# Select the dedicated Responses API adapter. The legacy "azure" provider
# remains available for existing Chat Completions deployments.
TRADINGAGENTS_LLM_PROVIDER=azure_responses
TRADINGAGENTS_QUICK_THINK_LLM=gpt-6.1-sol
TRADINGAGENTS_DEEP_THINK_LLM=gpt-6.1-sol
TRADINGAGENTS_OPENAI_REASONING_EFFORT=high
